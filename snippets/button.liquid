{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}
{% assign cober_bespoke_button = false %}
{% assign cober_shoe_collections = closest.product.collections | where: 'handle', 'giay-thủ-cong' %}
{% assign cober_button_label = block_settings.label %}
{% if cober_shoe_collections.size > 0 %}
  {% if block_settings.label == 'Đặt đóng theo phom chân' or block_settings.label == 'Yêu cầu tư vấn đặt đóng' %}
    {% assign cober_bespoke_button = true %}
  {% endif %}
{% endif %}
{% if cober_bespoke_button %}
  {% render 'cober-consultation-actions', product: closest.product, block: block, consultation_kind: 'bespoke' %}
{% else %}
<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
  "
  style="{% render 'size-style', settings: block_settings %}"
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {{ cober_button_label }}
</a>
{% endif %}
