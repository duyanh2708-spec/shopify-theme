{% doc %}
  Shared Messenger consultation and phone actions for COBER products and services.

  @param {object} product - The product being discussed.
  @param {object} block - The block rendering the actions.
  @param {string} [consultation_kind] - 'bespoke' for made-to-order shoes.
{% enddoc %}

{% liquid
  assign status_id = 'CoberMessengerStatus-' | append: block.id
  assign subject = 'dịch vụ'
  if consultation_kind == 'bespoke'
    assign status_id = 'CoberBespokeStatus-' | append: block.id
    assign subject = 'đôi giày'
  endif
%}

<script src="{{ 'cober-service-messenger.js' | asset_url }}" defer></script>
<div class="cober-consultation" data-cober-service-consultation {{ block.shopify_attributes }}>
  <div class="cober-consultation__actions">
    <a
      class="cober-consultation__button"
      href="https://m.me/cober.vn"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="{% if consultation_kind == 'bespoke' %}Yêu cầu tư vấn đặt đóng qua Messenger{% else %}Yêu cầu tư vấn dịch vụ qua Messenger{% endif %}"
      aria-describedby="{{ status_id }}"
      data-cober-service-messenger
      data-consultation-kind="{{ consultation_kind | default: 'service' }}"
      data-service-title="{{ product.title | escape }}"
      data-service-url="{{ shop.url | append: product.url | escape }}"
    >
      <span>Tư vấn Messenger</span>
    </a>
    <a class="cober-consultation__button" href="tel:+84828233633" aria-label="Gọi COBER: 0828 233 633">
      <svg class="cober-consultation__phone-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.79a2 2 0 0 1-.45 2.11L8.09 9.89a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.69A2 2 0 0 1 22 16.92Z" />
      </svg>
      <span>Gọi COBER</span>
    </a>
  </div>
  <p id="{{ status_id }}" data-cober-copy-status role="status" aria-live="polite" class="cober-consultation__status">Bấm để sao chép tên và link {{ subject }}, rồi dán vào Messenger và gửi.</p>
  <textarea data-cober-copy-manual readonly hidden aria-label="Tên và link {{ subject }} để sao chép" rows="3" style="width: 100%; font: inherit;"></textarea>
</div>

{% style %}
  .cober-consultation {
    width: 100%;
  }

  .cober-consultation__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 320px;
  }

  .cober-consultation__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 0;
    min-height: 56px;
    padding: 12px 14px;
    box-sizing: border-box;
    border: 1px solid transparent;
    border-radius: var(--style-border-radius-buttons-primary, 14px);
    background: #000;
    color: #d4af37;
    font-family: var(--font-body--family);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
    text-decoration: none;
  }

  .cober-consultation__button:hover {
    color: #d4af37;
    border-color: #d4af37;
  }

  .cober-consultation__button:focus-visible {
    outline: 2px solid #d4af37;
    outline-offset: 3px;
  }

  .cober-consultation__phone-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .cober-consultation__status {
    font-size: 0.875rem;
    margin-block: 8px;
  }
{% endstyle %}
